        <name>Submit Feedback</name>
        <onclick/>
        <order>100</order>
        <script><![CDATA[function onClick() {
    var rating = g_form.getValue('u_ratings');
    var comments = g_form.getValue('u_comments');
    var eventId = g_form.getValue('u_event_id'); 

    if (!rating || !eventId) {
        alert("Please provide all required fields.");
        return;
    }

    var ga = new GlideAjax('FeedbackCreationUtils');
    ga.addParam('sysparm_name', 'createFeedback');
    ga.addParam('sysparm_rating', rating);
    ga.addParam('sysparm_comments', comments);
    ga.addParam('sysparm_event_id', eventId);
    ga.getXMLAnswer(function(response) {
        var result = response;
        if (result === 'success') {
            alert("Thank you for your feedback!");
            g_form.setValue('rating', '');
            g_form.setValue('comments', '');
        } else {
            alert("Failed to submit feedback.");
        }
    });
}]]></script>
